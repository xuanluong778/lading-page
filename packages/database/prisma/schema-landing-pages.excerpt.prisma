enum LandingPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LandingPageTheme {
  MODERN
  PREMIUM
  MINIMAL
  BOLD
  CORPORATE
}

enum LandingPageDomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

enum LandingPageEventType {
  PAGE_VIEW
  CTA_CLICK
  FORM_START
  FORM_SUBMIT
  LEAD
}

model LandingPageTemplate {
  id             String           @id @default(uuid())
  organizationId String?          @map("organization_id")
  slug           String
  name           String
  category       String
  theme          LandingPageTheme @default(MODERN)
  description    String           @default("") @db.Text
  tags           String[]         @default([])
  thumbnailUrl   String?          @map("thumbnail_url") @db.VarChar(2000)
  definition     Json
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pages        LandingPage[]

  @@index([organizationId, updatedAt])
  @@index([slug])
  @@index([isSystem, slug])
  @@index([isSystem, category])
  @@map("landing_page_templates")
}

model LandingPage {
  id                 String                   @id @default(uuid())
  organizationId     String                   @map("organization_id")
  createdById        String?                  @map("created_by_id")
  templateId         String?                  @map("template_id")
  name               String
  slug               String
  status             LandingPageStatus        @default(DRAFT)
  theme              LandingPageTheme         @default(MODERN)
  draftSpec          Json                     @map("draft_spec")
  publishedSpec      Json?                    @map("published_spec")
  seoTitle           String?                  @map("seo_title") @db.VarChar(200)
  seoDescription     String?                  @map("seo_description") @db.VarChar(500)
  seoCanonical       String?                  @map("seo_canonical") @db.VarChar(2000)
  ogImage            String?                  @map("og_image") @db.VarChar(2000)
  robotsIndex        Boolean                  @default(true) @map("robots_index")
  subdomainSlug      String?                  @unique @map("subdomain_slug")
  customDomain       String?                  @unique @map("custom_domain") @db.VarChar(255)
  customDomainStatus LandingPageDomainStatus? @map("custom_domain_status")
  customDomainError  String?                  @map("custom_domain_error") @db.VarChar(500)
  customDomainVerifiedAt DateTime?            @map("custom_domain_verified_at")
  trackingConfig     Json?                    @map("tracking_config")
  previewToken       String?                  @unique @map("preview_token") @db.VarChar(64)
  previewExpiresAt   DateTime?                @map("preview_expires_at")
  publishedAt        DateTime?                @map("published_at")
  archivedAt         DateTime?                @map("archived_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     LandingPageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions     LandingPageVersion[]
  events       LandingPageEvent[]
  leads        Lead[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, subdomainSlug])
  @@index([customDomain])
  @@index([previewExpiresAt])
  @@map("landing_pages")
}

model LandingPageVersion {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  landingPageId  String   @map("landing_page_id")
  version        Int
  snapshot       Json
  note           String?  @db.VarChar(500)
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, version])
  @@index([organizationId, landingPageId, createdAt])
  @@map("landing_page_versions")
}

model LandingPageEvent {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  landingPageId  String               @map("landing_page_id")
  leadId         String?              @map("lead_id")
  eventType      LandingPageEventType @map("event_type")
  visitorId      String?              @map("visitor_id") @db.VarChar(80)
  sessionId      String?              @map("session_id") @db.VarChar(80)
  device         String?              @db.VarChar(40)
  utmSource      String?              @map("utm_source") @db.VarChar(120)
  utmMedium      String?              @map("utm_medium") @db.VarChar(120)
  utmCampaign    String?              @map("utm_campaign") @db.VarChar(160)
  utmContent     String?              @map("utm_content") @db.VarChar(160)
  utmTerm        String?              @map("utm_term") @db.VarChar(160)
  referrer       String?              @db.VarChar(2000)
  meta           Json?
  occurredAt     DateTime             @default(now()) @map("occurred_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([organizationId, landingPageId, eventType, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([organizationId, utmSource, utmCampaign])
  @@index([organizationId, visitorId])
  @@map("landing_page_events")
}
